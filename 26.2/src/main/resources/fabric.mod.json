{
	"schemaVersion": 1,
	"id": "smartphantomcontrol",
	"version": "${version}",
	"name": "Smart Phantom Control",
	"description": "Server-side (SP + MP, no client mod needed) tuning of Phantom insomnia spawning: custom eligibility threshold, per-eligible-night spawn-chance caps and group-size caps, falling back to plain vanilla behavior once the configured tiers run out.",
	"authors": [
		"Stefan Braun"
	],
	"contact": {
		"homepage": "https://github.com/StefanBraun2001/smart-phantom-control/blob/master/docs/GUIDE.md",
		"sources": "https://github.com/StefanBraun2001/smart-phantom-control",
		"issues": "https://github.com/StefanBraun2001/smart-phantom-control/issues"
	},
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"eu.stefanbraun612.smartphantomcontrol.SmartPhantomControl"
		]
	},
	"mixins": [
		"smartphantomcontrol.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"fabric-api": "*"
	}
}
